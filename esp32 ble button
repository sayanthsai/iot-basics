#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>

// -----------------------------
// GPIO
// -----------------------------
#define SWITCH_PIN  4

// -----------------------------
// BLE UUIDs
// -----------------------------
#define SERVICE_UUID        "12345678-1234-1234-1234-123456789001"
#define CHARACTERISTIC_UUID "12345678-1234-1234-1234-123456789002"

BLECharacteristic *pCharacteristic;

void setup()
{
  Serial.begin(115200);

  // Switch connected between GPIO 4 and GND
  pinMode(SWITCH_PIN, INPUT_PULLUP);

  // -----------------------------
  // Initialize BLE
  // -----------------------------
  BLEDevice::init("ESP32_SWITCH");

  // Create BLE server
  BLEServer *pServer = BLEDevice::createServer();

  // Create BLE service
  BLEService *pService =
      pServer->createService(SERVICE_UUID);

  // Create BLE characteristic
  pCharacteristic =
      pService->createCharacteristic(
        CHARACTERISTIC_UUID,
        BLECharacteristic::PROPERTY_READ |
        BLECharacteristic::PROPERTY_NOTIFY
      );

  // Initial value
  pCharacteristic->setValue("SWITCH OFF");

  // Start service
  pService->start();

  // Start advertising
  BLEAdvertising *pAdvertising =
      BLEDevice::getAdvertising();

  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);

  BLEDevice::startAdvertising();

  Serial.println("BLE Started");
  Serial.println("Device: ESP32_SWITCH");
  Serial.println("Waiting for phone...");
}

void loop()
{
  // Read switch
  int switchState = digitalRead(SWITCH_PIN);

  String data;

  if (switchState == LOW)
  {
    data = "SWITCH ON";
  }
  else
  {
    data = "SWITCH OFF";
  }

  // Send data through BLE
  pCharacteristic->setValue(data.c_str());
  pCharacteristic->notify();

  // Serial monitor
  Serial.println(data);

  delay(500);
}
