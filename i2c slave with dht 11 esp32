#include <Wire.h>
#include "DHT.h"

#define DHT_PIN 4
#define DHT_TYPE DHT11

#define I2C_ADDRESS 0x08

DHT dht(DHT_PIN, DHT_TYPE);

volatile int16_t temperature10 = 0;
volatile int16_t humidity10 = 0;

void onRequest()
{
  uint8_t data[4];

  int16_t t = temperature10;
  int16_t h = humidity10;

  data[0] = t & 0xFF;
  data[1] = (t >> 8) & 0xFF;

  data[2] = h & 0xFF;
  data[3] = (h >> 8) & 0xFF;

  Wire.write(data, 4);
}

void setup()
{
  Serial.begin(115200);

  dht.begin();

  delay(1000);

  Wire.onRequest(onRequest);

  if (!Wire.begin(I2C_ADDRESS, 21, 22, 100000))
  {
    Serial.println("I2C SLAVE FAILED!");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("I2C SLAVE READY");
}

void loop()
{
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  if (!isnan(temperature) && !isnan(humidity))
  {
    temperature10 = (int16_t)(temperature * 10);
    humidity10 = (int16_t)(humidity * 10);

    Serial.print("DHT11: ");
    Serial.print(temperature);
    Serial.print(" C   ");

    Serial.print(humidity);
    Serial.println(" %");
  }
  else
  {
    Serial.println("DHT11 ERROR");
  }

  delay(2000);
}
