/* =========================================================
   EXPERIMENT : ESP8266 I2C MASTER
   MASTER     : ESP8266 NodeMCU
   SLAVE      : ESP32
   SLAVE ADDR : 0x08

   ESP8266 I2C:
   SDA -> GPIO4  (D2)
   SCL -> GPIO5  (D1)
   ========================================================= */

#include <Wire.h>


// =========================================================
// I2C Configuration
// =========================================================

#define SLAVE_ADDRESS 0x08

#define I2C_SDA 4       // D2
#define I2C_SCL 5       // D1

#define I2C_SPEED 100000


// =========================================================
// SETUP
// =========================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("=================================");
  Serial.println(" ESP8266 I2C MASTER");
  Serial.println("=================================");


  // -------------------------------------------------------
  // Start I2C as MASTER
  // -------------------------------------------------------

  Wire.begin(I2C_SDA, I2C_SCL);

  Wire.setClock(I2C_SPEED);


  Serial.println("I2C Started");

  Serial.print("SDA: GPIO");
  Serial.println(I2C_SDA);

  Serial.print("SCL: GPIO");
  Serial.println(I2C_SCL);

  Serial.print("Slave Address: 0x");
  Serial.println(SLAVE_ADDRESS, HEX);

  Serial.println();
  Serial.println("I2C MASTER READY");
}


// =========================================================
// LOOP
// =========================================================

void loop()
{
  // -------------------------------------------------------
  // Request 4 bytes from ESP32 slave
  // -------------------------------------------------------

  uint8_t received =
    Wire.requestFrom(
      SLAVE_ADDRESS,
      (uint8_t)4
    );


  // -------------------------------------------------------
  // Check received data
  // -------------------------------------------------------

  if (received == 4)
  {
    // -----------------------------------------------------
    // Read four bytes
    // -----------------------------------------------------

    uint8_t b0 = Wire.read();
    uint8_t b1 = Wire.read();

    uint8_t b2 = Wire.read();
    uint8_t b3 = Wire.read();


    // -----------------------------------------------------
    // Reconstruct temperature
    // -----------------------------------------------------

    int16_t temperature10 =
      (int16_t)(
        b0 |
        ((uint16_t)b1 << 8)
      );


    // -----------------------------------------------------
    // Reconstruct humidity
    // -----------------------------------------------------

    int16_t humidity10 =
      (int16_t)(
        b2 |
        ((uint16_t)b3 << 8)
      );


    // -----------------------------------------------------
    // Convert back to decimal values
    // -----------------------------------------------------

    float temperature =
      temperature10 / 10.0;

    float humidity =
      humidity10 / 10.0;


    // -----------------------------------------------------
    // Display values
    // -----------------------------------------------------

    Serial.println();
    Serial.println("-----------------------------");

    Serial.print("Temperature: ");
    Serial.print(temperature, 1);
    Serial.println(" °C");

    Serial.print("Humidity: ");
    Serial.print(humidity, 1);
    Serial.println(" %");

    Serial.println("-----------------------------");
  }


  // -------------------------------------------------------
  // Communication error
  // -------------------------------------------------------

  else
  {
    Serial.print("I2C ERROR - received ");
    Serial.print(received);
    Serial.println(" bytes");


    // Clear remaining data

    while (Wire.available())
    {
      Wire.read();
    }
  }


  // -------------------------------------------------------
  // Wait before next request
  // -------------------------------------------------------

  delay(2000);
}
