#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <DHT.h>

// =====================================================
// WiFi
// =====================================================

const char* WIFI_SSID = "YOUR_WIFI_NAME";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// =====================================================
// ThingSpeak
// =====================================================

const char* WRITE_API_KEY = "BICSU4B76XAR4YE1";
const char* CHANNEL_ID = "3454376";
const char* READ_API_KEY = "7080LPCZHQ7NLBWN";

// =====================================================
// DHT11
// =====================================================

#define DHT_PIN 14
#define DHT_TYPE DHT11

DHT dht(DHT_PIN, DHT_TYPE);

// =====================================================
// LED
// =====================================================

#define LED_PIN 2

bool ledState = false;

// =====================================================
// Timing
// =====================================================

unsigned long lastUpdate = 0;

const unsigned long updateInterval = 20000;


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  dht.begin();

  Serial.println();
  Serial.println("ESP32 IoT SYSTEM");

  // WiFi
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected!");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Get initial LED state
  readLEDCommand();
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  if (millis() - lastUpdate >= updateInterval)
  {
    lastUpdate = millis();

    Serial.println();
    Serial.println("==============================");

    // -----------------------------------------
    // FIRST: Read LED command
    // -----------------------------------------

    readLEDCommand();


    // -----------------------------------------
    // Read DHT11
    // -----------------------------------------

    float temperature = dht.readTemperature();
    float humidity = dht.readHumidity();

    if (isnan(temperature) || isnan(humidity))
    {
      Serial.println("DHT11 reading failed!");
      return;
    }

    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.println(" °C");

    Serial.print("Humidity: ");
    Serial.print(humidity);
    Serial.println(" %");

    Serial.print("LED State: ");
    Serial.println(ledState ? "ON" : "OFF");


    // -----------------------------------------
    // Upload ALL THREE fields
    // -----------------------------------------

    uploadData(temperature, humidity);
  }
}


// =====================================================
// READ LED COMMAND
// =====================================================

void readLEDCommand()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("WiFi disconnected");
    return;
  }

  WiFiClientSecure client;

  client.setInsecure();

  HTTPClient http;

  String url =
    "https://api.thingspeak.com/channels/" +
    String(CHANNEL_ID) +
    "/fields/3/last.txt?api_key=" +
    String(READ_API_KEY);

  Serial.println("Reading LED command...");

  if (!http.begin(client, url))
  {
    Serial.println("HTTP begin failed");
    return;
  }

  int httpCode = http.GET();

  if (httpCode == 200)
  {
    String command = http.getString();

    command.trim();

    Serial.print("ThingSpeak Field 3 = ");
    Serial.println(command);

    if (command == "1")
    {
      ledState = true;

      digitalWrite(LED_PIN, HIGH);

      Serial.println("LED ON");
    }

    else if (command == "0")
    {
      ledState = false;

      digitalWrite(LED_PIN, LOW);

      Serial.println("LED OFF");
    }

    else
    {
      Serial.println("Invalid/empty LED command");
      Serial.println("Keeping previous LED state");
    }
  }

  else
  {
    Serial.print("HTTP Error: ");
    Serial.println(httpCode);

    // IMPORTANT:
    // Don't change LED state if reading fails.
    Serial.print("Keeping LED state: ");
    Serial.println(ledState ? "ON" : "OFF");
  }

  http.end();
}


// =====================================================
// UPLOAD DATA
// =====================================================

void uploadData(float temperature, float humidity)
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("WiFi disconnected!");
    return;
  }

  WiFiClientSecure client;

  client.setInsecure();

  HTTPClient http;

  // IMPORTANT:
  // Send Field 3 together with Field 1 and Field 2

  String url =
    "https://api.thingspeak.com/update?api_key=" +
    String(WRITE_API_KEY) +
    "&field1=" +
    String(temperature) +
    "&field2=" +
    String(humidity) +
    "&field3=" +
    String(ledState ? 1 : 0);

  Serial.println("Uploading to ThingSpeak...");

  if (!http.begin(client, url))
  {
    Serial.println("HTTP begin failed!");
    return;
  }

  int httpCode = http.GET();

  Serial.print("HTTP Code: ");
  Serial.println(httpCode);

  if (httpCode == 200)
  {
    String response = http.getString();

    Serial.print("ThingSpeak Entry: ");
    Serial.println(response);

    Serial.println("Data uploaded successfully!");
  }

  else
  {
    Serial.print("Upload error: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}
